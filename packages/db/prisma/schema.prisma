// WePlay 1차 스키마 (PLAN.md §6 기준, 1차 범위만)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  MASTER
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum GroupStatus {
  ACTIVE
  SUSPENDED
}

enum GroupRole {
  ADMIN
  USER
}

enum GroupMembershipStatus {
  APPROVED
  LEFT
  REMOVED
  BLOCKED
}

enum TeamRole {
  ADMIN
  USER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
  EXPIRED
}

enum TeamVisibility {
  PUBLIC
  PRIVATE
}

enum RequestType {
  GROUP_JOIN
  TEAM_JOIN
}

model User {
  id           String       @id @default(cuid())
  email        String?      @unique
  username     String?      @unique // MASTER 로그인용
  passwordHash String? // MASTER 전용 (bcrypt)
  googleSub    String?      @unique
  name         String
  birthDate    DateTime?    @db.Date
  phone        String?
  avatarUrl    String?
  platformRole PlatformRole @default(USER)
  status       UserStatus   @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  groupMemberships GroupMembership[]
  teamMembers      TeamMember[]
  requests         GroupMembershipRequest[] @relation("RequestUser")
  reviewedRequests GroupMembershipRequest[] @relation("RequestReviewer")
}

model Group {
  id                String      @id @default(cuid())
  name              String // 활성 그룹 이름 중복 금지: 마이그레이션의 partial unique index
  description       String?
  joinCode          String      @unique
  joinCodeRotatedAt DateTime    @default(now())
  joinCodeEnabled   Boolean     @default(true)
  status            GroupStatus @default(ACTIVE)
  primaryAdminId    String? // 대표 ADMIN userId
  createdById       String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  groupMemberships GroupMembership[]
  teams            Team[]
  requests         GroupMembershipRequest[]
}

model GroupMembership {
  id        String                @id @default(cuid())
  userId    String
  groupId   String
  role      GroupRole             @default(USER)
  status    GroupMembershipStatus @default(APPROVED)
  joinedAt  DateTime              @default(now())
  leftAt    DateTime?
  updatedAt DateTime              @updatedAt
  user      User                  @relation(fields: [userId], references: [id])
  group     Group                 @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
  @@index([groupId, status, role])
}

model Team {
  id                String         @id @default(cuid())
  primaryAdminId String?   // 대표 TEAM_ADMIN userId
  groupId           String
  name              String
  description       String?
  joinCode          String         @unique
  joinCodeRotatedAt DateTime       @default(now())
  joinCodeEnabled   Boolean        @default(true)
  visibility        TeamVisibility @default(PUBLIC) // PUBLIC: 가입 선택 목록에 노출
  requireApproval   Boolean        @default(true) // false면 가입 즉시 승인
  createdById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  group             Group          @relation(fields: [groupId], references: [id])

  members      TeamMember[]
  requestTeams MembershipRequestTeam[]

  @@index([groupId, deletedAt])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  groupId  String
  role     TeamRole @default(USER) // 팀 ADMIN은 여러 명 가능
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([groupId, userId])
}

model GroupMembershipRequest {
  id         String        @id @default(cuid())
  type       RequestType
  userId     String
  groupId    String
  status     RequestStatus @default(PENDING)
  message    String?
  reviewerId String?
  reviewNote String?
  reviewedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation("RequestUser", fields: [userId], references: [id])
  reviewer   User?         @relation("RequestReviewer", fields: [reviewerId], references: [id])
  group      Group         @relation(fields: [groupId], references: [id])

  teams MembershipRequestTeam[]

  @@index([groupId, status, createdAt])
  @@index([userId, status])
}

model MembershipRequestTeam {
  requestId String
  teamId    String
  approved  Boolean?
  request   GroupMembershipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  team      Team                   @relation(fields: [teamId], references: [id])

  @@id([requestId, teamId])
}

model AuditLog {
  id         String   @id @default(cuid())
  groupId    String?
  actorId    String?
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([groupId, createdAt])
  @@index([targetType, targetId])
}
