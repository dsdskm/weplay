{
  "name": "weplay",
  "private": true,
  "packageManager": "pnpm@11.0.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --ui=stream",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @weplay/db generate",
    "db:migrate": "pnpm --filter @weplay/db migrate",
    "db:seed": "pnpm --filter @weplay/db seed",
    "db:deploy": "pnpm --filter @weplay/db migrate:deploy",
    "test": "bash scripts/test/all.sh",
    "test:db": "bash scripts/test/all.sh --db",
    "test:unit": "pnpm --filter @weplay/shared test",
    "test:api": "node scripts/test/api-smoke.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
