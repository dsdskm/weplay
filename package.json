{
  "name": "weplay",
  "private": true,
  "packageManager": "pnpm@11.0.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm db:deploy && turbo run dev --ui=stream",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @weplay/db generate",
    "db:migrate": "pnpm --filter @weplay/db migrate",
    "db:seed": "pnpm --filter @weplay/db seed",
    "db:deploy": "pnpm --filter @weplay/db migrate:deploy"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
